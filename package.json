{
  "name": "@chariow/n8n-nodes-chariow",
  "version": "0.0.7",
  "description": "n8n community nodes for Chariow - the digital products platform for creators and entrepreneurs",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chariow",
    "ecommerce",
    "digital-products",
    "automation",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://chariow.com",
  "author": {
    "name": "Chariow",
    "email": "support@chariow.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chariow/n8n-nodes.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier nodes credentials --write",
    "format:check": "prettier nodes credentials --check",
    "typecheck": "tsc --noEmit",
    "test:local": "pnpm build && n8n-node dev",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ChariowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Chariow/Chariow.node.js",
      "dist/nodes/Chariow/ChariowTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.31.0",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.8.0",
    "prettier": "3.8.3",
    "release-it": "^20.0.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    },
    "overrides": {
      "minimatch@3": ">=3.1.4 <4",
      "minimatch@9": ">=9.0.7 <10",
      "ajv@6": ">=6.14.0 <7",
      "flatted@3": ">=3.4.2 <4",
      "brace-expansion@1": ">=1.1.13 <2",
      "lodash@4": ">=4.18.1 <5",
      "uuid@10": ">=11.1.1 <12",
      "tmp": ">=0.2.6 <0.3",
      "form-data@4": ">=4.0.6 <5",
      "undici@6": ">=6.27.0 <7",
      "undici@7": ">=7.28.0 <8",
      "js-yaml@4": ">=4.2.0 <5"
    }
  }
}
